# See https://help.github.com/articles/ignoring-files/
# for more information about ignoring files.

# Dependencies
/node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Testing
/coverage/

# Next.js
/.next/
/out/

# Production build
/build/

# Environment variables and secrets
.env
.env.*
!.env.example

# Vercel
.vercel/

# Prisma generated client
/generated/prisma/
/src/generated/prisma/
/app/generated/prisma/

# TypeScript
*.tsbuildinfo
next-env.d.ts

# Debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Local AI assistant configuration
/.agents/
/.claude/
/.windsurf/
/skills-lock.json

# Operating system files
.DS_Store
Thumbs.db

# Certificates and private keys
*.pem
*.key
*.crt

# IDE and editor files
.vscode/
.idea/
*.swp
*.swo

# Temporary files
*.tmp
*.temp
.cache/