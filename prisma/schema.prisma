// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Sex {
  FEMALE
  MALE
  OTHER
  UNKNOWN
}

enum AssessmentStatus {
  SENT
  COMPLETED
  EXPIRED
}

enum AssessmentDeliveryMode {
  EMAIL
  PREVIEW
}

enum RiskBand {
  LOW
  MODERATE
  HIGH
  VERY_HIGH
}

enum FhirSyncStatus {
  PENDING
  SYNCED
  FAILED
  READ_ONLY
}

enum FhirOwnership {
  OWNED
  READ_ONLY
}

enum ClinicalDataSource {
  LOCAL
  FHIR
}

model Clinician {
  id           String      @id @default(cuid())
  email        String      @unique
  passwordHash String
  name         String
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  patients     Patient[]
  sessions     Session[]
  labImports   LabImport[]
}

model Patient {
  id               String         @id @default(cuid())
  clinicianId      String
  fullName         String
  dob              DateTime       @db.Date
  sex              Sex
  mrn              String         @unique
  email            String?
  phone            String?
  fhirResourceId   String?        @unique
  fhirOwnership    FhirOwnership?
  fhirSyncStatus   FhirSyncStatus @default(PENDING)
  fhirLastSyncedAt DateTime?
  fhirLastError    String?        @db.VarChar(500)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  clinician        Clinician      @relation(fields: [clinicianId], references: [id], onDelete: Cascade)
  assessments      Assessment[]
  labResults       LabResult[]

  @@index([clinicianId])
  @@index([clinicianId, fullName])
  @@index([clinicianId, fhirSyncStatus])
}

model Session {
  id           String    @id @default(cuid())
  tokenHash    String    @unique
  clinicianId  String
  expiresAt    DateTime
  createdAt    DateTime  @default(now())
  lastActiveAt DateTime  @default(now())
  clinician    Clinician @relation(fields: [clinicianId], references: [id], onDelete: Cascade)

  @@index([clinicianId])
  @@index([expiresAt])
}

model Assessment {
  id                   String                 @id @default(cuid())
  patientId            String
  questionnaireId      String                 @default("dsma-8")
  questionnaireVersion String                 @default("1.0")
  tokenHash            String                 @unique
  status               AssessmentStatus       @default(SENT)
  deliveryMode         AssessmentDeliveryMode @default(EMAIL)
  emailProviderId      String?
  sentAt               DateTime               @default(now())
  expiresAt            DateTime
  completedAt          DateTime?
  responses            Json?
  score                Int?
  riskBand             RiskBand?
  patient              Patient                @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId, sentAt])
  @@index([status, expiresAt])
}

model LabImport {
  id            String      @id @default(cuid())
  clinicianId   String
  fileName      String
  totalRows     Int
  acceptedCount Int
  rejectedCount Int
  report        Json?
  createdAt     DateTime    @default(now())
  clinician     Clinician   @relation(fields: [clinicianId], references: [id], onDelete: Cascade)
  labResults    LabResult[]

  @@index([clinicianId, createdAt])
}

model LabResult {
  id               String             @id @default(cuid())
  patientId        String
  importId         String?
  collectedDate    DateTime           @db.Date
  testCode         String
  testName         String
  value            Decimal            @db.Decimal(12, 4)
  unit             String
  refLow           Decimal?           @db.Decimal(12, 4)
  refHigh          Decimal?           @db.Decimal(12, 4)
  source           ClinicalDataSource @default(LOCAL)
  fhirResourceId   String?            @unique
  fhirSyncStatus   FhirSyncStatus     @default(PENDING)
  fhirLastSyncedAt DateTime?
  fhirLastError    String?            @db.VarChar(500)
  createdAt        DateTime           @default(now())
  patient          Patient            @relation(fields: [patientId], references: [id], onDelete: Cascade)
  import           LabImport?         @relation(fields: [importId], references: [id], onDelete: SetNull)

  @@unique([patientId, collectedDate, testCode])
  @@index([patientId, testCode, collectedDate])
  @@index([importId])
  @@index([fhirSyncStatus])
  @@index([source])
}
