DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=verify-full"

# Real email delivery is the default and is required for the submitted app.
EMAIL_DELIVERY_MODE="resend"
APP_URL="http://localhost:3000"
RESEND_API_KEY=""
EMAIL_FROM="PulseTrack <assessments@your-verified-domain.example>"

# Optional local-only testing without sending:
# EMAIL_DELIVERY_MODE="preview"
