DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=verify-full"

# Real email delivery is the default and is required for the submitted app.
EMAIL_DELIVERY_MODE="resend"
APP_URL="http://localhost:3000"
RESEND_API_KEY=""
EMAIL_FROM="PulseTrack <assessments@your-verified-domain.example>"

# Optional local-only testing without sending:
# EMAIL_DELIVERY_MODE="preview"

# Tier 2: HAPI FHIR R4 integration. Keep the personal API key server-only.
FHIR_BASE_URL="https://fhir-challenge.vihagent.net/fhir"
FHIR_CANDIDATE_ID=""
FHIR_API_KEY=""

# Tier 3: server-only Gemini clinical review.
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.1-flash-lite"
