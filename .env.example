DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=verify-full"

# Local development can expose a preview link without sending an email.
EMAIL_DELIVERY_MODE="preview"
APP_URL="http://localhost:3000"

# For real delivery, set EMAIL_DELIVERY_MODE="resend" and configure:
RESEND_API_KEY=""
EMAIL_FROM="PulseTrack <assessments@your-verified-domain.example>"
